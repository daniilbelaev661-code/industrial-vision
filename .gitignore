# Виртуальное окружение
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Модели — веса не кладём в Git
models/*.pth
models/*.pt
models/*.engine
models/*.trt
models/*.tflite

# Данные и датасеты — только .gitkeep
datasets/*
!datasets/.gitkeep
data/*
!data/.gitkeep

# События и логи (генерируются в runtime)
events/*
logs/*
!events/.gitkeep
!logs/.gitkeep

# Видео и медиа
*.mp4
*.avi
*.mkv
*.mov
*.webm

# Секреты
.env
configs/local.yaml
configs/*.secret.yaml

# IDE / редакторы
.vscode/
.idea/
*.swp
*.swo

# ОС
.DS_Store
Thumbs.db
desktop.ini

# Временные файлы
*.tmp
*.bak
*.log
!logs/*.log

# Сгенерированные файлы обучения и логи
runs/
weights/
logs/

# Разрешаем финальные модели
!models/yolov8n.pt
!models/ppe_detector.pt
!models/smoke_fire_detector.pt
!models/*.onnx

# Разрешаем демонстрационные видео
!data/test_smoke.mp4
!data/test_fire.mp4